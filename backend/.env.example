NODE_ENV=development
PORT=4000
# Local replica set started by `npm run db:start` (transactions need a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/crm?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:5173
SYNC_INDEXES_ON_BOOT=true
# Number of reverse proxies in front of the API. 0 when running locally.
TRUST_PROXY=0
SEED_COUNT=5000
